{
  "name": "@uni-helper/unocss-preset-uni",
  "type": "module",
  "version": "0.5.1",
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "warn"
    }
  },
  "description": "UnoCSS preset for uni-app. Auto-switches between wind3/wind4 on H5 and preset-applet on mini-programs, with rem/rpx, attributify and per-platform variants built in.",
  "author": "KeJun",
  "license": "MIT",
  "homepage": "https://github.com/uni-helper/unocss-preset-uni#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/unocss-preset-uni.git"
  },
  "bugs": "https://github.com/uni-helper/unocss-preset-uni/issues",
  "keywords": [
    "unocss",
    "uni-app",
    "unocss-preset"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm build",
    "release": "bumpp",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "play:mp-weixin": "npm -C playground run dev:mp-weixin",
    "build:mp-weixin": "npm -C playground run build:mp-weixin",
    "play:h5": "npm -C playground run dev:h5",
    "build:h5": "npm -C playground run build:h5"
  },
  "peerDependencies": {
    "unocss": "catalog:unocss",
    "unocss-applet": "catalog:unocss"
  },
  "dependencies": {
    "@uni-helper/uni-env": "catalog:uni-app",
    "@unocss/preset-legacy-compat": "catalog:unocss",
    "@unocss/preset-mini": "catalog:unocss",
    "@unocss/rule-utils": "catalog:unocss",
    "unocss": "catalog:unocss",
    "unocss-applet": "catalog:unocss"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "@uni-helper/eslint-config": "catalog:eslint",
    "@unocss/core": "catalog:unocss",
    "@unocss/eslint-config": "catalog:unocss",
    "bumpp": "catalog:utils",
    "eslint": "catalog:eslint",
    "tsdown": "catalog:utils",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:vite"
  }
}
